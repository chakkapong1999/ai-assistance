# Copy to .env (never commit it). Which variables are required depends on the mode.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_review?sslmode=disable
HTTP_ADDR=:8080

# api
BITBUCKET_WEBHOOK_SECRET=change-me
# Dashboard REST API (/api/v1): comma-separated token:role[:user_id], role = viewer | author | senior | lead | admin, token >= 16 chars.
# Unset = the REST API is not served at all. The dashboard server sends one of these as a bearer token.
# Generate one with: openssl rand -hex 24
# author, senior and lead tokens need the person's user id (see README, Fix workflow).
API_TOKENS=
# worker, backfill
BITBUCKET_TOKEN=
# Repositories are created automatically when first seen. true (default) = they start with review ON, so their
# code is sent to the reviewer; false = they start OFF until an admin switches them on in the dashboard.
# Only the starting value of repositories created afterwards; existing ones and admin choices are never changed.
# REVIEW_NEW_REPOS=true

# Polling (worker): find new commits and open pull requests (each PR is also reviewed as one diff) without a webhook.
# Off unless POLL_REPOS is set.
# Comma-separated workspace/repo, or workspace/* for every repository the token can see.
# POLL_REPOS=acme/api,acme/web
# How often (min 1m). Each round costs a few API calls per repository, more when branches changed.
# POLL_INTERVAL=5m
# How far back the FIRST poll of a branch reads (Go duration, min 1h). Later polls read everything since the last one.
# POLL_LOOKBACK=168h

# Worker safety net (min 1m): queues again anything whose job was lost (webhook deliveries, commits and pull requests
# stuck as pending/running) and marks work that keeps failing as failed. GET /api/v1/health shows what it did.
# RECONCILE_INTERVAL=5m

# One-off history import: `go run ./cmd/server --mode=backfill` reads the repositories named in POLL_REPOS.
# BACKFILL_DAYS=90          how far back to read each branch (1-3650)
# BACKFILL_MAX_COMMITS=2000 most commits read per branch, newest first
# BACKFILL_REVIEW=false     true = queue a review for every commit found (costs tokens); false = record only

# mock = never call an LLM (default, safe for dev and CI); claude_cli = real review via `claude -p`
REVIEWER_MODE=mock
# clean | findings | invalid_json | usage_limit | timeout
MOCK_REVIEW_SCENARIO=findings
# simulated review time, e.g. 2s
MOCK_REVIEW_DELAY=0s
# only used when REVIEWER_MODE=claude_cli
CLAUDE_BIN=claude

# Optional: enables the Postgres integration tests (internal/store). Must be an EMPTY
# database whose name ends in _test; its public schema is dropped on every run.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_review_test?sslmode=disable

# Optional: send Bitbucket API calls somewhere else, e.g. `go run ./cmd/mockbitbucket` at http://localhost:7990.
# The token is sent to this URL, so leave it unset against real Bitbucket.
# BITBUCKET_BASE_URL=
