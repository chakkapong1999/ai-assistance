# Server-side only; the browser never calls the API directly.
API_BASE_URL=http://localhost:8080
# Must be one of the API's API_TOKENS. An admin token lets the dashboard toggle repositories and re-review commits;
# a viewer token makes it read-only. It identifies this server, not the people using it.
API_TOKEN=
# Time zone used to show dates (the API itself is UTC).
DISPLAY_TZ=Asia/Bangkok
