# docker compose reads this file as .env (cp .env.example .env; never commit it).
# Every variable in backend/.env.example also works here (the backend containers get all of them),
# except DATABASE_URL, HTTP_ADDR and BITBUCKET_BASE_URL=localhost, which compose sets for the containers.

BITBUCKET_WEBHOOK_SECRET=change-me
# token:role[,token:role], role = viewer | admin, token >= 16 chars. Generate: openssl rand -hex 24
# token:role[:user_id]; author, senior and lead tokens need the person's user id, e.g. xxxxxxxxxxxxxxxx:senior:7
API_TOKENS=dev-admin-token-change-me:admin
# what the dashboard sends; must be one of the tokens above
API_TOKEN=dev-admin-token-change-me
# DISPLAY_TZ=Asia/Bangkok

# worker
BITBUCKET_TOKEN=
# POLL_REPOS=acme/*
# POLL_INTERVAL=5m
# REVIEW_NEW_REPOS=true
REVIEWER_MODE=mock
